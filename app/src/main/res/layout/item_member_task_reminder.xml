<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_reminder_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_reminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_corner_stroke_et"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_reminder_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_8dp"
            android:layout_marginTop="@dimen/margin_8dp"
            app:layout_constraintEnd_toStartOf="@+id/cl_voice_note"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tv_reminder"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:textAlignment="textStart"
                android:textColor="@color/black2"
                android:textSize="@dimen/text_size_14sp"
                android:textStyle="normal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Learning to write concise and meaningful sentences helps improve communication skills effectively and meaningful sentences helps improve communication skills." />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_tagged_member"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/margin_4dp"
                android:paddingBottom="0dp"
                android:visibility="visible"
                app:layout_constraintTop_toBottomOf="@+id/tv_reminder"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/iv_member_tagged"
                    android:layout_width="@dimen/margin_16dp"
                    android:layout_height="@dimen/margin_16dp"
                    android:contentDescription="@string/dummy_description"
                    android:src="@drawable/ic_voice_note_stop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/app_primary_text">

                </ImageView>

                <TextView
                    android:id="@+id/tv_tagged_member_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_4dp"
                    android:gravity="bottom"
                    android:text="Member"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/text_size_12sp"
                    android:textStyle="normal"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_member_tagged"
                    app:layout_constraintStart_toEndOf="@+id/iv_member_tagged"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/iv_member_tagged" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_reminder_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/margin_4dp"
                android:paddingBottom="@dimen/margin_8dp"
                app:layout_constraintTop_toBottomOf="@+id/cl_tagged_member"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/reminder_time_icon"
                    android:layout_width="@dimen/margin_16dp"
                    android:layout_height="@dimen/margin_16dp"
                    android:contentDescription="@string/dummy_description"
                    android:src="@drawable/ic_task_reminder"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                </ImageView>

                <TextView
                    android:id="@+id/reminder_set_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_4dp"
                    android:gravity="bottom"
                    android:text="@string/member_task_reminder_set_at"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/text_size_12sp"
                    android:textStyle="normal"
                    app:layout_constraintBottom_toBottomOf="@+id/reminder_time_icon"
                    app:layout_constraintStart_toEndOf="@+id/reminder_time_icon"
                    app:layout_constraintTop_toTopOf="@+id/reminder_time_icon" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_voice_note"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginVertical="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvImage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="@dimen/margin_8dp"
                android:padding="@dimen/margin_8dp"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/toggle_play_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/iv_image_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/dummy_description"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_image" />
            </androidx.cardview.widget.CardView>

            <ImageView
                android:id="@+id/toggle_play_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/dummy_description"
                android:padding="6dp"
                android:src="@drawable/ic_voice_note"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tagged_member"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/colorPrimary"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/tagged_member"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/dummy_description"
                android:padding="4dp"
                android:src="@drawable/ic_user"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/iv_option_remove"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/gray"
                tools:visibility="gone" />

            <ImageView
                android:id="@+id/iv_option_remove"
                android:layout_width="32dp"
                android:layout_height="48dp"
                android:contentDescription="@string/dummy_description"
                android:paddingVertical="@dimen/margin_8dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/gray"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/toggle_play_button"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>