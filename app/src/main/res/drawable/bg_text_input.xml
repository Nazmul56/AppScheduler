<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">

            <corners android:radius="4dp" />

            <solid android:color="@color/colorDisabled" />


            <stroke android:width="@dimen/stroke_width_2" android:color="@color/color_stroke_input_layout" />

        </shape>
    </item>

    <item android:state_enabled="true" android:state_focused="false">
        <shape android:shape="rectangle">

            <corners android:radius="4dp" />

            <solid android:color="@color/white" />

            <stroke android:width="@dimen/stroke_width_2" android:color="@color/color_stroke_input_layout" />

        </shape>
    </item>

    <item android:state_enabled="true" android:state_focused="true">
        <shape android:shape="rectangle">

            <corners android:radius="4dp" />

            <solid android:color="@color/white" />

            <stroke android:width="@dimen/stroke_width_2" android:color="@color/color_stroke_input_activated" />

        </shape>
    </item>
</selector>
