<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TabLayoutStyle" parent="Base.Widget.Design.TabLayout">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="EditTextStyle" parent="">
        <item name="android:textColor">@color/etInputText</item>
        <item name="android:background">@drawable/bg_text_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">@dimen/text_size_primary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:colorControlActivated">@color/appPrimaryText</item>
    </style>

    <style name="TextInputStyle" parent="">
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="errorIconDrawable">@null</item>
        <item name="errorIconTint">@color/error_color</item>
        <item name="errorTextAppearance">@style/ErrorAppearance</item>
    </style>

    <style name="datepicker" parent="Theme.AppCompat.Light.Dialog">
        <!-- Use raw hex colors instead of resource references -->
        <item name="colorAccent">#FF5722</item>
        <item name="android:colorAccent">#FF5722</item>
        <item name="android:textColor">#FF5722</item>
        <item name="android:textColorPrimaryInverse">#FFFFFF</item>
        <item name="android:textColorSecondaryInverse">#FFFFFF</item>
        <item name="android:textColorPrimary">#FF5722</item>
        <item name="colorControlActivated">#FF5722</item>
        <item name="android:buttonBarButtonStyle">@style/ButtonStyle</item>
    </style>

    <style name="ButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#354148</item>
    </style>

    <style name="ErrorAppearance" parent="@android:style/TextAppearance">
        <item name="android:textColor">@color/error_color</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>