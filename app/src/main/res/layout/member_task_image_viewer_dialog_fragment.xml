<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_8dp"
        android:background="@drawable/bg_popup_dialog"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp">
        <androidx.constraintlayout.widget.ConstraintLayout

            android:id="@+id/cl_reminder_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingBottom="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_reminder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/margin_8dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="@string/image"
                android:textColor="@color/app_primary_text"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btnDiscard"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_ripple_with_stroke"
                android:contentDescription="@string/close"
                android:padding="@dimen/margin_8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_clear"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.github.chrisbanes.photoview.PhotoView
            android:id="@+id/ivReminderImage"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:minHeight="200dp"
            android:maxHeight="300dp"
            android:padding="4dp"
            android:layout_marginTop="@dimen/margin_8dp"
            android:layout_marginHorizontal="@dimen/margin_8dp"
            android:layout_marginBottom="@dimen/margin_16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_image"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_reminder_header"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>